# LHM Engine Configuration
# Copy this to .env and fill in your values

# Telegram (REQUIRED for alerts)
LHM_TELEGRAM_TOKEN=your_bot_token_here
LHM_TELEGRAM_CHAT_ID=your_chat_id_here

# BetPawa (optional - for live betting)
BETPAWA_PHONE=your_phone
BETPAWA_PASSWORD=your_password

# Betika (optional - for live betting)
BETIKA_PHONE=your_phone
BETIKA_PASSWORD=your_password

# Free API keys (optional - enhances data quality)
ODDS_API_KEY=your_odds_api_key
API_FOOTBALL_KEY=your_api_football_key
DEEPSEEK_API_KEY=your_deepseek_key

# Engine mode
DRY_RUN=true
USE_FREE_SCRAPERS=true
